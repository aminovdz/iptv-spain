---
import { Tv, Sparkles, MessageCircle, Menu, X, ArrowRight, ShieldCheck } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Ventajas', href: '/#features' },
  { name: 'Precios', href: '/#pricing' },
  { name: 'SmartOne Intercept', href: '/smartone-iptv' },
  { name: 'Lista IPTV', href: '/lista-iptv-espana' },
  { name: 'Dispositivos', href: '/#devices' },
  { name: 'Ciudades', href: '/#cities' },
  { name: 'Guías & Blog', href: '/guides' },
  { name: 'Contacto', href: '/contact' }
];

const whatsappUrl = "https://wa.me/18036582620?text=Hola%21+Deseo+probar+gratis+el+servicio+IPTV+Espa%C3%B1a+durante+24+horas.";
---

<header class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#08090D]/95 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.6)]">
  <!-- Top Promotion Ticker -->
  <div class="bg-gradient-to-r from-[#DC2626]/20 via-[#F59E0B]/20 to-[#DC2626]/20 border-b border-[#DC2626]/30 text-center py-1.5 px-4 text-xs font-medium text-gray-200">
    <div class="flex items-center justify-center gap-2 max-w-7xl mx-auto flex-wrap sm:flex-nowrap">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#DC2626] text-white uppercase tracking-wider">
        Oferta Especial España
      </span>
      <span class="text-gray-200 text-[11px] sm:text-xs">
        Plan 12 Meses con Reproductor VIP incluido por <strong class="text-white font-bold">55,00 €</strong> (~4,58 €/mes) · ¡Activación instantánea 24/7 y garantía total!
      </span>
      <a href="/#pricing" class="inline-flex items-center gap-1 text-[#F59E0B] hover:text-white hover:underline font-semibold ml-1 text-xs">
        Ver Tarifas <ArrowRight class="w-3 h-3" />
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#DC2626] rounded-lg p-1" aria-label="IPTV España — Volver al inicio">
        <div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-[#161926] to-[#08090D] border border-[#DC2626]/40 flex items-center justify-center shadow-[0_0_20px_rgba(220,38,38,0.3)] group-hover:border-[#DC2626] transition-colors">
          <Tv class="w-5 h-5 text-[#DC2626] group-hover:scale-110 transition-transform duration-300" />
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-[#08090D] animate-pulse"></span>
        </div>
        <div class="flex flex-col">
          <span class="font-black text-xl tracking-tight text-white flex items-center gap-1.5">
            IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">ESPAÑA</span>
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-widest text-emerald-400 -mt-1 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> Streaming 4K & Anti-Freeze 9.8™
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-lg text-xs xl:text-sm font-medium transition-all duration-200 ${
              currentPath === link.href
                ? 'text-[#F59E0B] bg-[#DC2626]/15 font-semibold'
                : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white text-xs font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(220,38,38,0.35)] hover:shadow-[0_0_30px_rgba(220,38,38,0.55)] transition-all duration-200 hover:scale-[1.02]"
          aria-label="Contactar soporte WhatsApp y solicitar prueba gratuita"
        >
          <MessageCircle class="w-4 h-4 text-emerald-300" />
          <span>Prueba 24h Gratis</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-2 rounded-lg bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#F59E0B] text-xs font-bold"
          aria-label="Contactar por WhatsApp"
        >
          <MessageCircle class="w-4 h-4" />
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2.5 rounded-xl bg-[#0F111A] border border-white/[0.08] text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#DC2626]"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Abrir menú móvil"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-nav"
    class="hidden lg:hidden border-t border-white/[0.08] bg-[#08090D]/98 backdrop-blur-2xl transition-all duration-300"
    role="region"
    aria-label="Menú móvil"
  >
    <div class="px-4 pt-3 pb-6 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'text-[#F59E0B] bg-[#DC2626]/20 font-bold'
              : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
          }`}
        >
          {link.name}
        </a>
      ))}
      <div class="pt-4 border-t border-white/[0.06] flex flex-col gap-3">
        <a
          href="/#pricing"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#DC2626] text-white font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(220,38,38,0.35)]"
        >
          <Sparkles class="w-4 h-4" />
          <span>Ver Tarifas (desde 8 €)</span>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#0F111A] border border-[#DC2626]/40 text-[#F59E0B] font-bold text-sm tracking-wide"
        >
          <MessageCircle class="w-4 h-4 text-emerald-400" />
          <span>Atención Directa WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    const links = mobileNav.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
