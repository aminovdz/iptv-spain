---
import { CheckCircle2, Tv, X } from 'lucide-astro';
---

<div
  id="social-proof-popup"
  class="fixed bottom-24 left-6 z-40 hidden max-w-xs sm:max-w-sm w-full transition-all duration-300 transform -translate-x-full opacity-0 pointer-events-auto"
  role="status"
  aria-live="polite"
>
  <div class="relative rounded-2xl bg-[#0F111A]/95 border border-[#DC2626]/30 p-4 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl flex items-center gap-3">
    
    <!-- Close button -->
    <button
      id="close-social-proof"
      type="button"
      class="absolute top-2 right-2 text-gray-500 hover:text-white p-1"
      aria-label="Cerrar notificación"
    >
      <X class="w-3.5 h-3.5" />
    </button>

    <!-- Avatar / Icon -->
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#DC2626] to-[#F59E0B] flex items-center justify-center text-white flex-shrink-0 shadow-md">
      <Tv class="w-5 h-5" />
    </div>

    <!-- Info text -->
    <div class="pr-3">
      <div class="flex items-center gap-1.5 text-[10px] text-emerald-400 font-bold uppercase tracking-wider mb-0.5">
        <CheckCircle2 class="w-3 h-3" />
        <span>Activación Reciente</span>
      </div>
      <p id="social-proof-text" class="text-xs font-semibold text-white leading-tight">
        Carlos de Madrid acaba de activar el Plan 12 Meses
      </p>
      <span id="social-proof-time" class="text-[10px] text-gray-400 block mt-0.5">
        Hace 3 minutos
      </span>
    </div>

  </div>
</div>

<script>
  const notifications = [
    { text: "Carlos de Madrid acaba de activar el Plan 12 Meses", time: "Hace 3 minutos" },
    { text: "Marc de Barcelona renovó su suscripción anual con reproductor VIP", time: "Hace 7 minutos" },
    { text: "Alejandro de Valencia solicitó una prueba 24h gratis", time: "Hace 12 minutos" },
    { text: "Bar Los Arcos en Sevilla activó el Plan IPTV Profesional", time: "Hace 19 minutos" },
    { text: "Iñigo de Bilbao activó su Fire TV Stick en 4K", time: "Hace 24 minutos" }
  ];

  let currentIndex = 0;
  const popup = document.getElementById('social-proof-popup');
  const textEl = document.getElementById('social-proof-text');
  const timeEl = document.getElementById('social-proof-time');
  const closeBtn = document.getElementById('close-social-proof');

  let isDismissed = false;

  function showSocialNotification() {
    if (isDismissed || !popup || !textEl || !timeEl) return;

    const current = notifications[currentIndex];
    textEl.textContent = current.text;
    timeEl.textContent = current.time;
    currentIndex = (currentIndex + 1) % notifications.length;

    popup.classList.remove('hidden');
    setTimeout(() => {
      popup.classList.remove('-translate-x-full', 'opacity-0');
    }, 50);

    // Hide after 6 seconds
    setTimeout(() => {
      if (popup) {
        popup.classList.add('-translate-x-full', 'opacity-0');
        setTimeout(() => {
          popup.classList.add('hidden');
        }, 300);
      }
    }, 6000);
  }

  // Trigger initial notification after 7 seconds, then every 28 seconds
  setTimeout(() => {
    showSocialNotification();
    setInterval(showSocialNotification, 28000);
  }, 7000);

  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      isDismissed = true;
      if (popup) {
        popup.classList.add('-translate-x-full', 'opacity-0');
        setTimeout(() => popup.classList.add('hidden'), 300);
      }
    });
  }
</script>
