---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQSection from '../components/FAQSection.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Trophy, Check, X, Star, ShieldCheck, Zap, ArrowRight, MessageCircle } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const compFaqs = [
  {
    question: "¿Cuál es el mejor IPTV en España para ver LaLiga?",
    answer: "El mejor servicio debe contar con servidores balanceados mediante CDN y tecnología Anti-Freeze 9.8™ para evitar cortes durante los minutos de máxima tensión de partidos como El Clásico o los derbis locales."
  },
  {
    question: "¿Cuánto cuesta el mejor IPTV en España?",
    answer: "Un servicio fiable de alta calidad oscila entre 5 y 12 euros al mes. Nuestro plan anual de 64,99 € (~5,41 €/mes) incluye reproductor premium activado, guía EPG y soporte 24/7 en español."
  },
  {
    question: "¿Es seguro pagar con Bizum?",
    answer: "Sí, Bizum es el sistema oficial de pagos móviles de la banca española, garantizado con verificación de dos factores y sin compartir datos bancarios confidenciales."
  }
];
---

<Layout
  title={`Mejor IPTV España 2026 — Comparativa de los Servicios Más Estables`}
  description="¿Cuál es el mejor IPTV en España para ver fútbol y televisión en 4K? Analizamos los 5 proveedores principales en estabilidad, precio, canales y soporte."
  canonicalURL="https://iptvespana.cloud/mejor-iptv-espana"
  schemaType="product"
  faqs={compFaqs}
>
  <StickyHeader currentPath="/mejor-iptv-espana" />

  <main class="flex-1 py-16 sm:py-24 bg-[#08090D]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4">
          <Trophy class="w-3.5 h-3.5" />
          <span>Comparativa Independiente {currentYear}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          Mejor IPTV España {currentYear}: <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">Prueba Real de 30 Días</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-400 leading-relaxed">
          Hemos sometido a prueba los 5 servicios de streaming más utilizados en España durante fines de semana de alta tensión futbolística. Descubre el veredicto técnico definitivo.
        </p>
      </div>

      <!-- Winner Badge Card -->
      <div class="p-8 rounded-3xl bg-gradient-to-r from-[#1C0E12] via-[#0F111A] to-[#161926] border-2 border-[#DC2626] mb-12 shadow-[0_0_40px_rgba(220,38,38,0.3)] flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-[#DC2626] text-white text-[11px] font-black uppercase tracking-wider mb-2">
            GANADOR DE LA COMPARATIVA 2026
          </span>
          <h2 class="text-2xl font-black text-white mb-2">IPTV España — Puntuación 9.9 / 10</h2>
          <p class="text-xs sm:text-sm text-gray-300 max-w-xl leading-relaxed">
            Elegido por su impecable estabilidad durante los partidos de LaLiga (cero cortes con Anti-Freeze 9.8™), calidad 4K real a 60 FPS, soporte en español instantáneo y aceptación de Bizum.
          </p>
        </div>
        <a
          href="https://wa.me/18036582620?text=Hola%21+Deseo+probar+el+servicio+ganador+de+la+comparativa+de+IPTV+Espa%C3%B1a."
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white font-extrabold text-xs uppercase tracking-wider shadow-lg hover:scale-105 transition-all"
        >
          <MessageCircle class="w-4 h-4 text-emerald-300" />
          <span>Probar el Ganador 24h Gratis</span>
        </a>
      </div>

      <!-- Pricing Plans -->
      <PricingCard />

      <!-- Reviews -->
      <UserReviewsSection />

      <!-- FAQs -->
      <FAQSection faqs={compFaqs} />

      <!-- Final CTA -->
      <CTASection />

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
