---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import FAQSection, { defaultFaqs } from '../components/FAQSection.astro';
import ContactForm from '../components/ContactForm.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import ExitPopup from '../components/ExitPopup.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

const currentYear = new Date().getFullYear();
---

<Layout
  title={`IPTV Deportes España ${currentYear} — Todo el Fútbol y LaLiga en Directo 4K`}
  description="Mira todos los partidos de LaLiga EA Sports, Champions League y Fórmula 1 sin pagar 90 €/mes en Movistar o DAZN. Streaming 4K fluido con tecnología Anti-Freeze 9.8™."
  canonicalURL="https://iptvespana.cloud/landing-v2"
  schemaType="product"
  faqs={defaultFaqs}
>
  <StickyHeader currentPath="/landing-v2" />

  <main class="flex-1">
    <!-- Sport-First Hero -->
    <Hero
      headline="Ver Todo el Fútbol en Directo 4K Sin Movistar ni DAZN"
      subheadline="¿Por qué pagar 90 € al mes entre Movistar+ y DAZN para ver el fútbol español? Con nuestro servicio de IPTV disfrutas de cada partido de LaLiga EA Sports, Champions League, Fórmula 1 y MotoGP en 4K Ultra HD a 60 FPS sin cortes y con pago por Bizum."
    />

    <!-- Real-time Live Matches Engine -->
    <LiveScores />

    <!-- Features -->
    <FeatureGrid />

    <!-- Pricing (12-Month Plan First) -->
    <PricingCard />

    <!-- High-Converting CTA -->
    <CTASection />

    <!-- Process -->
    <ProcessSteps />

    <!-- Devices -->
    <SupportedDevices />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- Referral -->
    <ReferralBanner />

    <!-- FAQs -->
    <FAQSection />

    <!-- Contact Form -->
    <ContactForm />
  </main>

  <Footer />
  <ExitPopup />
  <FloatingWhatsApp />
</Layout>
