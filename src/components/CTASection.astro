---
import { MessageCircle, ArrowRight, ShieldCheck, Zap, Star } from 'lucide-astro';

const whatsappTrialUrl = "https://wa.me/18036582620?text=Hola%21+Deseo+activar+mi+prueba+gratuita+de+24+horas+de+IPTV+Espa%C3%B1a.";
---

<section class="py-20 relative overflow-hidden bg-gradient-to-b from-[#08090D] via-[#0F111A] to-[#08090D]">
  <!-- Glow Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-r from-[#DC2626]/20 via-[#F59E0B]/15 to-[#DC2626]/20 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Star Rating Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.05] border border-white/[0.1] text-xs font-semibold text-gray-200 mb-6 shadow-sm">
      <div class="flex items-center text-amber-400">
        <Star class="w-3.5 h-3.5 fill-amber-400" />
        <Star class="w-3.5 h-3.5 fill-amber-400" />
        <Star class="w-3.5 h-3.5 fill-amber-400" />
        <Star class="w-3.5 h-3.5 fill-amber-400" />
        <Star class="w-3.5 h-3.5 fill-amber-400" />
      </div>
      <span>Calificación 4.9/5 · 1.485 Clientes Satisfechos en España</span>
    </div>

    <!-- Main Heading -->
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6 max-w-4xl mx-auto">
      ¿Preparado para Vivir el Fútbol y la Televisión <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">Sin Cortes ni Permanencias</span>?
    </h2>

    <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
      Activa tu suscripción en menos de 2 minutos vía WhatsApp. Compatible con tu Smart TV, Firestick y móvil. ¡Paga con total seguridad mediante tarjeta o PayPal!
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a
        href={whatsappTrialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(220,38,38,0.4)] hover:shadow-[0_0_40px_rgba(220,38,38,0.65)] hover:scale-[1.02] transition-all duration-300"
      >
        <MessageCircle class="w-5 h-5 text-emerald-300" />
        <span>Solicitar Prueba 24h Gratis</span>
      </a>
      <a
        href="/#pricing"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#0F111A] border border-[#DC2626]/40 hover:border-[#DC2626] text-white font-bold text-sm tracking-wide hover:bg-white/[0.04] transition-all duration-200"
      >
        <span>Ver Tarifas Oficiales</span>
        <ArrowRight class="w-4 h-4 text-[#F59E0B]" />
      </a>
    </div>

    <!-- Trust Badges Bar -->
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-gray-400 font-medium pt-8 border-t border-white/[0.08]">
      <div class="flex items-center gap-2">
        <Zap class="w-4 h-4 text-emerald-400" />
        <span>Activación Inmediata</span>
      </div>
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-emerald-400" />
        <span>Garantía Reembolso 24h</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#F59E0B]">Pago Seguro</span>
        <span>Tarjeta & PayPal</span>
      </div>
      <div class="flex items-center gap-2">
        <MessageCircle class="w-4 h-4 text-emerald-400" />
        <span>Soporte 24/7 en Español</span>
      </div>
    </div>
  </div>
</section>
