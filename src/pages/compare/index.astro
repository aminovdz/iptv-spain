---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { Trophy, ArrowRight } from 'lucide-astro';

const comparisons = [
  {
    title: "IPTV España vs SmartOne IPTV",
    slug: "iptv-espana-vs-smartone-iptv",
    desc: "Análisis técnico de servidores dedicados Anti-Freeze, precios anuales y soporte 24/7 en español frente a la aplicación SmartOne."
  },
  {
    title: "IPTV España vs Operadores Tradicionales",
    slug: "iptv-espana-vs-operadores-tradicionales",
    desc: "¿Por qué pagar más de 90 € al mes por paquetes cerrados? Descubre cómo ahorrar más de 900 € al año en fútbol y deportes sin permanencia."
  }
];
---

<Layout
  title="Comparativas de IPTV en España 2026 — Análisis Objetivo"
  description="Todas las comparativas entre IPTV España y sus principales competidores y alternativas del mercado español. Ahorro, calidad 4K y estabilidad."
  canonicalURL="https://iptve-spana.cloud/compare"
>
  <StickyHeader currentPath="/compare" />

  <main class="flex-1 py-16 sm:py-24 bg-[#08090D]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#F59E0B] text-xs font-bold uppercase tracking-wider mb-4">
          <Trophy class="w-3.5 h-3.5" />
          <span>Centro de Comparativas Oficial</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
          Comparativas de IPTV en España
        </h1>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          Analizamos objetivamente las diferencias técnicas, precios, calidad de imagen y atención al cliente entre nuestro servicio y las alternativas más conocidas del mercado español.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {comparisons.map((c) => (
          <a
            href={`/compare/${c.slug}`}
            class="group p-8 rounded-3xl bg-[#0F111A] border border-white/[0.08] hover:border-[#DC2626]/40 transition-all duration-300 hover:-translate-y-1 shadow-lg flex flex-col justify-between"
          >
            <div>
              <h2 class="text-xl font-bold text-white group-hover:text-[#F59E0B] transition-colors mb-3">
                {c.title}
              </h2>
              <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-6">
                {c.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-white/[0.05] flex items-center justify-between text-xs font-bold text-[#DC2626] group-hover:text-[#F59E0B] transition-colors">
              <span>Leer Comparativa Completa</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
