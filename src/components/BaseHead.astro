---
interface Props {
  title: string;
  description: string;
  keywords?: string | string[];
  image?: string;
  canonicalURL?: URL | string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  image = '/images/og-banner.webp',
  canonicalURL = Astro.url,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const defaultKeywords = "iptv españa, smartone iptv, lista iptv españa, iptv profesional, mejor iptv españa, iptv laliga, comprar iptv, iptv m3u españa, iptv paypal, iptv 4k españa, smart tv iptv";
const keywordsString = Array.isArray(keywords) 
  ? keywords.join(', ') 
  : (keywords || defaultKeywords);

const siteUrl = 'https://iptve-spana.cloud';
let rawCanonical = typeof canonicalURL === 'string' ? canonicalURL : new URL(Astro.url.pathname, Astro.site || siteUrl).toString();
let cleanUrlObj = new URL(rawCanonical);
cleanUrlObj.search = '';
if (!cleanUrlObj.pathname.endsWith('/') && !cleanUrlObj.pathname.includes('.')) {
  cleanUrlObj.pathname += '/';
}
const fullCanonicalURL = cleanUrlObj.toString();
const ogImageUrl = new URL(image, Astro.site || siteUrl).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<meta name="generator" content="Astro v5.3" />
<meta name="theme-color" content="#08090D" />
<meta name="color-scheme" content="dark" />

<!-- SEO Canonical & Hreflang Tags -->
<link rel="canonical" href={fullCanonicalURL} />
<link rel="alternate" hreflang="es-ES" href={fullCanonicalURL} />
<link rel="alternate" hreflang="es" href={fullCanonicalURL} />
<link rel="alternate" hreflang="x-default" href={siteUrl} />

<!-- Custom Favicon & Device Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="apple-mobile-web-app-title" content="IPTV España" />
<meta name="application-name" content="IPTV España" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content="IPTV España" />
<meta name="publisher" content="IPTV España" />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="IPTV España" />
<meta property="og:locale" content="es_ES" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={fullCanonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Performance Preconnect & Typography -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
