---
import { Tv, Mail, MessageCircle, Send, MapPin, Lock, ExternalLink, ShieldCheck, CreditCard } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const cities = [
  { name: 'Madrid', slug: 'madrid', region: 'Comunidad de Madrid' },
  { name: 'Barcelona', slug: 'barcelona', region: 'Cataluña' },
  { name: 'Valencia', slug: 'valencia', region: 'Comunidad Valenciana' },
  { name: 'Sevilla', slug: 'sevilla', region: 'Andalucía' },
  { name: 'Zaragoza', slug: 'zaragoza', region: 'Aragón' },
  { name: 'Málaga', slug: 'malaga', region: 'Andalucía' },
  { name: 'Bilbao', slug: 'bilbao', region: 'País Vasco' },
  { name: 'Murcia', slug: 'murcia', region: 'Región de Murcia' }
];

const quickLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Plan 12 Meses (Recomendado)', href: '/#pricing' },
  { name: 'SmartOne IPTV Reseña & Alternativas', href: '/smartone-iptv' },
  { name: 'Lista IPTV España M3U', href: '/lista-iptv-espana' },
  { name: 'IPTV Profesional (Bares y Empresas)', href: '/iptv-profesional' },
  { name: 'Mejor IPTV España 2026', href: '/mejor-iptv-espana' },
  { name: 'Programa de Recomendados', href: '/referral' },
  { name: 'Contacto y Soporte', href: '/contact' }
];

const comparisonLinks = [
  { name: 'IPTV España vs IPTV-ES (iptv-es.com)', href: '/compare/iptv-espana-vs-iptv-es' },
  { name: 'IPTV España vs OptiWebTV (optiwebtv.live)', href: '/compare/iptv-espana-vs-optiwebtv' },
  { name: 'IPTV España vs IPTVEspana24 (iptvespana24.com)', href: '/compare/iptv-espana-vs-iptvespana24' },
  { name: 'IPTV España vs SmartOne IPTV', href: '/compare/iptv-espana-vs-smartone-iptv' },
  { name: 'IPTV vs Operadores Tradicionales', href: '/compare/iptv-espana-vs-operadores-tradicionales' }
];

const guidesLinks = [
  { name: '¿Es Legal el IPTV en España? Ley Kangaroo y CNMC', href: '/guides/es-legal-el-iptv-en-espana' },
  { name: 'Cómo Ver LaLiga Online en Directo en 2026', href: '/guides/como-ver-laliga-online' },
  { name: 'SmartOne IPTV Opiniones: ¿Vale la Pena en 2026?', href: '/guides/smartone-iptv-opiniones' },
  { name: 'Mejor IPTV España: Guía de Streaming 4K', href: '/guides/mejor-iptv-espana' },
  { name: 'Todas las Guías y Tutoriales', href: '/guides' }
];

const legalLinks = [
  { name: 'Política de Privacidad (RGPD)', href: '/privacy' },
  { name: 'Términos y Condiciones de Uso', href: '/terms' },
  { name: 'Política de Reembolso (Válida 24 Horas)', href: '/refund' },
  { name: 'Aviso de Derechos de Autor (DMCA)', href: '/dmca' },
  { name: 'Aviso Legal y Descargo de Responsabilidad', href: '/disclaimer' }
];
---

<footer class="bg-[#050608] border-t border-white/[0.08] text-gray-400 text-sm relative" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pie de página IPTV España</h2>

  <!-- Top Community Bar: WhatsApp & Telegram Channels -->
  <div class="border-b border-white/[0.06] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-[#0F111A] rounded-2xl p-6 sm:p-8 border border-white/[0.06]">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#F59E0B] text-xs font-bold uppercase tracking-wider mb-2">
            Comunidad VIP España
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-white">
            Únete a Nuestros Canales de Noticias y Soporte
          </h3>
          <p class="text-gray-400 text-sm mt-1 max-w-xl">
            Recibe avisos de partidos de LaLiga, eventos deportivos en directo y promociones exclusivas.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
          <a
            href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-[#10B981] hover:bg-[#059669] text-white font-bold text-xs uppercase tracking-wider shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Canal WhatsApp VIP</span>
          </a>
          <a
            href="https://t.me/castvera_com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-[#0088cc] hover:bg-[#0077b5] text-white font-bold text-xs uppercase tracking-wider shadow-[0_0_20px_rgba(0,136,204,0.3)] transition-all"
          >
            <Send class="w-4 h-4" />
            <span>Canal Telegram VIP</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Support Column -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#161926] to-[#08090D] border border-[#DC2626]/40 flex items-center justify-center text-[#DC2626]">
            <Tv class="w-5 h-5" />
          </div>
          <span class="font-black text-xl tracking-tight text-white">
            IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">ESPAÑA</span>
          </span>
        </a>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed max-w-sm">
          Servicio de televisión y streaming digital de máxima estabilidad para España. Transmisión en 4K Ultra HD a 60 FPS con tecnología Anti-Freeze 9.8™, activación en 2 minutos y atención personalizada en español.
        </p>
        
        <div class="space-y-2 pt-2 text-xs text-gray-300">
          <div class="flex items-center gap-2">
            <Mail class="w-4 h-4 text-[#F59E0B]" />
            <a href="mailto:contact@iptve-spana.cloud" class="hover:text-white transition-colors">contact@iptve-spana.cloud</a>
          </div>
          <div class="flex items-center gap-2">
            <Mail class="w-4 h-4 text-[#F59E0B]" />
            <a href="mailto:support@castvera.com" class="hover:text-white transition-colors">support@castvera.com</a>
          </div>
          <div class="flex items-center gap-2">
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">+1 (803) 658-2620 (Atención 24/7)</a>
          </div>
        </div>

        <!-- Payment Badges -->
        <div class="pt-3">
          <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-2">Métodos de Pago Seguros</span>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#0F111A] border border-white/[0.1] text-gray-200">Visa / Mastercard</span>
            <span class="px-2.5 py-1 rounded bg-[#0F111A] border border-white/[0.1] font-semibold text-[#F59E0B]">PayPal</span>
            <span class="px-2.5 py-1 rounded bg-[#0F111A] border border-white/[0.1] font-semibold text-emerald-400">Cripto (USDT/BTC)</span>
            <span class="px-2.5 py-1 rounded bg-[#0F111A] border border-white/[0.1] text-gray-400">SEPA</span>
          </div>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Navegación</h4>
        <ul class="space-y-2.5 text-xs">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white hover:underline transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Comparativas & Guías -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Guías y Comparativas</h4>
        <ul class="space-y-2.5 text-xs mb-6">
          {guidesLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-[#F59E0B] hover:underline transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
        <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Comparativas</h4>
        <ul class="space-y-2.5 text-xs">
          {comparisonLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white hover:underline transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal & Cobertura Local -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Legal & Cumplimiento</h4>
        <ul class="space-y-2.5 text-xs mb-6">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white hover:underline transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
        <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Cobertura en España</h4>
        <ul class="grid grid-cols-2 gap-2 text-xs">
          {cities.map((city) => (
            <li>
              <a href={`/locations/${city.slug}`} class="text-gray-400 hover:text-[#F59E0B] transition-colors flex items-center gap-1">
                <MapPin class="w-3 h-3 text-[#DC2626]" /> {city.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="mt-14 pt-8 border-t border-white/[0.06] text-xs text-gray-500 space-y-4">
      <p class="leading-relaxed text-[11px]">
        <strong>Aviso Legal y Descargo de Responsabilidad:</strong> IPTV España proporciona soluciones de transmisión de datos digitales para reproductores multimedia compatibles. No alojamos, distribuimos ni retransmitimos contenidos protegidos por derechos de autor de terceros. Las marcas, nombres comerciales y logotipos de competidores mencionados pertenecen a sus respectivos titulares y se citan únicamente con fines informativos y de comparación conforme a la legislación vigente.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2 text-[11px]">
        <span>© {currentYear} IPTV España. Todos los derechos reservados. Desarrollado con tecnología Edge Cloudflare.</span>
        <div class="flex items-center gap-4">
          <a href="/privacy" class="hover:underline">Privacidad</a>
          <a href="/terms" class="hover:underline">Términos</a>
          <a href="/refund" class="hover:underline">Reembolso (24h)</a>
          <a href="/dmca" class="hover:underline">DMCA</a>
        </div>
      </div>
    </div>
  </div>
</footer>
