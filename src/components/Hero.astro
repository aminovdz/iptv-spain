---
import { Star, Tv, CheckCircle2, ArrowRight, MessageCircle, Signal, Shield, Zap, Flame } from 'lucide-astro';

interface Props {
  headline?: string;
  subheadline?: string;
  cityName?: string;
}

const {
  cityName,
  headline,
  subheadline = cityName
    ? `Disfruta del mejor servicio de IPTV en ${cityName} sin antenas parabólicas ni tarifas abusivas de operadoras. Accede a streaming 4K Ultra HD estable con tecnología Anti-Freeze 9.8™, todo el fútbol de LaLiga en directo y activación en 2 minutos.`
    : "¿Cansado de pagar 90 € al mes por paquetes de televisión tradicionales? Nuestro servicio premium de IPTV España te ofrece la máxima calidad en 4K y 8K a 60 FPS, sin cortes ni buffering durante los partidos de máxima audiencia."
} = Astro.props;

const whatsappTrialUrl = "https://wa.me/18036582620?text=Hola%21+Quiero+probar+gratis+el+servicio+IPTV+Espa%C3%B1a+durante+24+horas.";
---

<section class="relative pt-8 pb-20 md:pt-16 md:pb-28 overflow-hidden" aria-labelledby="hero-title">
  <!-- Ambient Lighting Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[850px] h-[400px] bg-gradient-to-b from-[#DC2626]/15 via-[#F59E0B]/08 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-44 right-10 w-96 h-96 bg-[#DC2626]/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-[#F59E0B]/08 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & SEO Keyword Placement -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#0F111A] border border-[#DC2626]/40 shadow-[0_0_20px_rgba(220,38,38,0.2)] mb-6">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-xs font-semibold tracking-wide text-gray-200 flex items-center gap-1.5">
            <span class="text-[#F59E0B] font-bold">Proveedor Oficial en España</span> · Servidores Dedicados 10 Gbps Anti-Freeze
          </span>
        </div>

        <!-- Single Page H1 Tag with Exact Primary Keyword Placement -->
        <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12] mb-6">
          {headline ? (
            headline
          ) : cityName ? (
            <>
              Servicio IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">{cityName}</span> — Streaming 4K Sin Cortes
            </>
          ) : (
            <>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-100 to-gray-300">
                El Mejor Servicio
              </span>{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">
                IPTV España
              </span>{" "}
              <span class="text-white block sm:inline">
                en Alta Definición 4K
              </span>
            </>
          )}
        </h1>

        <!-- Primary Keyword within First 75-100 Words -->
        <p class="text-base sm:text-lg md:text-xl text-gray-300 font-normal leading-relaxed mb-8 max-w-2xl">
          {subheadline} Olvídate de los contratos de permanencia abusivos y las caídas de señal en momentos clave. Disfruta de <strong class="text-white font-semibold">IPTV España</strong> con máxima fluidez, imagen en 4K Ultra HD y atención personalizada en español vía WhatsApp.
        </p>

        <!-- Social Proof Aggregate Stars Rating -->
        <div class="flex items-center gap-4 py-3 px-4 rounded-2xl bg-[#0F111A]/80 border border-white/[0.08] mb-8 shadow-sm">
          <div class="flex items-center text-amber-400">
            <Star class="w-4 h-4 fill-amber-400" />
            <Star class="w-4 h-4 fill-amber-400" />
            <Star class="w-4 h-4 fill-amber-400" />
            <Star class="w-4 h-4 fill-amber-400" />
            <Star class="w-4 h-4 fill-amber-400" />
          </div>
          <span class="text-xs text-gray-300 font-medium">
            <strong class="text-white font-bold">4.9 / 5</strong> basado en <span class="text-amber-400 font-semibold underline underline-offset-2">1.485 opiniones</span> de clientes en España
          </span>
        </div>

        <!-- High-Converting CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-8">
          <a
            href={whatsappTrialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(220,38,38,0.4)] hover:shadow-[0_0_40px_rgba(220,38,38,0.65)] hover:scale-[1.02] transition-all duration-300"
            aria-label="Solicitar prueba gratuita de 24 horas por WhatsApp"
          >
            <MessageCircle class="w-5 h-5 text-emerald-300" />
            <span>Probar 24 Horas Gratis</span>
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#0F111A] border border-[#DC2626]/40 hover:border-[#DC2626] text-white font-bold text-sm tracking-wide hover:bg-white/[0.04] transition-all duration-200"
          >
            <span>Ver Tarifas y Planes</span>
            <ArrowRight class="w-4 h-4 text-[#F59E0B]" />
          </a>
        </div>

        <!-- Feature Checkmarks List -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-3 gap-x-6 text-xs text-gray-300 font-medium pt-2 border-t border-white/[0.08] w-full">
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Anti-Freeze™ 9.8</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Streaming 4K 60 FPS</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Todo el Fútbol LaLiga</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Pago Seguro Cifrado</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Sin Permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
            <span>Garantía 24 Horas</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive TV / Streaming UI Mockup -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Glow Box -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-[#DC2626]/40 via-[#F59E0B]/30 to-[#DC2626]/40 blur-xl opacity-70"></div>
          
          <!-- Mockup Frame -->
          <div class="relative rounded-2xl bg-[#0F111A] border border-white/[0.12] p-4 shadow-2xl overflow-hidden backdrop-blur-xl">
            
            <!-- Top Player Bar -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/[0.08] text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] animate-pulse"></span>
                <span class="font-bold text-white tracking-wide">LALIGA EA SPORTS · DIRECTO</span>
              </div>
              <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#F59E0B] font-extrabold text-[10px]">
                <span>4K ULTRA HD</span>
              </div>
            </div>

            <!-- Match Screen Preview -->
            <div class="relative rounded-xl overflow-hidden aspect-video bg-gradient-to-br from-neutral-900 via-neutral-950 to-neutral-900 border border-white/[0.08] flex flex-col justify-between p-4">
              <!-- Scoreboard -->
              <div class="flex items-center justify-between bg-black/60 backdrop-blur-md rounded-lg p-2.5 border border-white/[0.1]">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-white text-sm">Real Madrid</span>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 bg-[#DC2626] rounded text-white font-black text-sm">
                  <span>2</span>
                  <span class="text-xs opacity-75">-</span>
                  <span>1</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-white text-sm">FC Barcelona</span>
                </div>
              </div>

              <!-- Live Match Status Pill -->
              <div class="flex items-center justify-between text-xs text-gray-300">
                <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
                  <Signal class="w-3.5 h-3.5" /> 60 FPS Estable
                </span>
                <span class="px-2 py-0.5 rounded bg-black/70 text-gray-200 text-[11px] font-mono">
                  Minuto 74' · El Clásico
                </span>
              </div>
            </div>

            <!-- Quick Features Ticker under Screen -->
            <div class="mt-4 pt-3 border-t border-white/[0.08] grid grid-cols-3 gap-2 text-center text-[11px]">
              <div class="p-2 rounded-lg bg-white/[0.02] border border-white/[0.05]">
                <Zap class="w-4 h-4 text-[#F59E0B] mx-auto mb-1" />
                <span class="text-gray-300 font-semibold block">Sin Cortes</span>
                <span class="text-[9px] text-gray-400">Anti-Freeze™</span>
              </div>
              <div class="p-2 rounded-lg bg-white/[0.02] border border-white/[0.05]">
                <Shield class="w-4 h-4 text-emerald-400 mx-auto mb-1" />
                <span class="text-gray-300 font-semibold block">99.9% Uptime</span>
                <span class="text-[9px] text-gray-400">Servidores Dedicados</span>
              </div>
              <div class="p-2 rounded-lg bg-white/[0.02] border border-white/[0.05]">
                <Flame class="w-4 h-4 text-[#DC2626] mx-auto mb-1" />
                <span class="text-gray-300 font-semibold block">2 Minutos</span>
                <span class="text-[9px] text-gray-400">Activación Rápida</span>
              </div>
            </div>

            <!-- Price Comparison Tag -->
            <div class="mt-3 p-2.5 rounded-xl bg-gradient-to-r from-[#DC2626]/20 to-[#F59E0B]/20 border border-[#DC2626]/30 flex items-center justify-between text-xs">
              <span class="text-gray-300 font-medium">Movistar + DAZN: <s class="text-red-400">90 €/mes</s></span>
              <span class="text-emerald-400 font-bold">IPTV España: desde 4,58 €/mes</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
