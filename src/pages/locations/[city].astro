const { city } = Astro.props;
const currentYear = new Date().getFullYear();
---

<Layout
  title={city.metaTitle}
  description={city.metaDescription}
  canonicalURL={`https://iptvespana.cloud/locations/${city.slug}`}
  schemaType="city"
  cityName={city.name}
>
  <StickyHeader currentPath={`/locations/${city.slug}`} />

  <main class="flex-1">
    <!-- Local Hero -->
    <Hero
      headline={`Servicio IPTV en ${city.name} — Streaming 4K Sin Cortes`}
      subheadline={`Disfruta de la mejor televisión digital en ${city.name} (${city.region}). Acceso inmediato a LaLiga en directo, eventos deportivos y canales en 4K Ultra HD sin permanencia.`}
      cityName={city.name}
    />

    <!-- Local Infrastructure Highlights -->
    <section class="py-12 bg-[#06070B] border-y border-white/[0.08]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-xs">
          <div class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.06] flex items-center gap-3">
            <Server class="w-6 h-6 text-[#DC2626] flex-shrink-0" />
            <div>
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Centro de Conexión</span>
              <strong class="text-white text-xs">{city.datacenterHub}</strong>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.06] flex items-center gap-3">
            <Wifi class="w-6 h-6 text-emerald-400 flex-shrink-0" />
            <div>
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Latencia Local Promedio</span>
              <strong class="text-emerald-400 text-xs font-mono">{city.latency} (Enrutamiento Directo)</strong>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.06] flex items-center gap-3">
            <Zap class="w-6 h-6 text-[#F59E0B] flex-shrink-0" />
            <div>
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Deporte en {city.name}</span>
              <strong class="text-white text-xs">{city.localClub}</strong>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.06] flex items-center gap-3">
            <MapPin class="w-6 h-6 text-cyan-400 flex-shrink-0" />
            <div>
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Población Cobertura</span>
              <strong class="text-white text-xs">{city.population}</strong>
            </div>
          </div>
        </div>

        <div class="mt-6 p-4 rounded-xl bg-[#0F111A]/80 border border-white/[0.05] text-xs text-gray-300">
          <p><strong>Detalle de Cobertura Local en {city.name}:</strong> {city.localDetails} Compatible con {city.isps}.</p>
        </div>
      </div>
    </section>

    <!-- Live Matches -->
    <LiveScores />

    <!-- Feature Grid -->
    <FeatureGrid />

    <!-- Pricing (12-Month Plan First) -->
    <PricingCard />

    <!-- Process -->
    <ProcessSteps />

    <!-- Supported Devices -->
    <SupportedDevices />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- CTA Section -->
    <CTASection />

    <!-- FAQs -->
    <FAQSection />

    <!-- Contact Form -->
    <ContactForm />
  </main>

  <Footer />
  <FloatingWhatsApp />
  <ExitPopup />
</Layout>
