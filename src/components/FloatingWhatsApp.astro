---
import { MessageCircle } from 'lucide-astro';

const whatsappUrl = "https://wa.me/18036582620?text=Hola%21+Deseo+informaci%C3%B3n+sobre+el+servicio+IPTV+Espa%C3%B1a+y+la+prueba+de+24+horas.";
---

<aside class="fixed bottom-6 left-6 z-50 flex items-center group pointer-events-auto" aria-label="Atención al cliente en WhatsApp">
  <!-- Subtle Notification Ping Badge -->
  <span class="absolute -top-1 -right-1 flex h-4 w-4 z-20">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500 border-2 border-[#08090D]"></span>
  </span>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center w-14 h-14 rounded-full bg-[#10B981] hover:bg-[#059669] text-white shadow-[0_4px_25px_rgba(16,185,129,0.45)] hover:shadow-[0_6px_35px_rgba(16,185,129,0.65)] hover:scale-110 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-emerald-500/40"
    aria-label="Abrir conversación de WhatsApp con soporte IPTV España"
  >
    <MessageCircle class="w-7 h-7" />
  </a>

  <!-- Hover Tooltip -->
  <div class="hidden sm:block absolute left-16 ml-3 px-3 py-1.5 rounded-xl bg-[#0F111A] border border-white/[0.1] text-xs font-semibold text-white whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none shadow-xl">
    <div class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>¿Dudas? Chatea en directo por WhatsApp</span>
    </div>
  </div>
</aside>
