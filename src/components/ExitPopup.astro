---
import { MessageCircle, X, Clock, Gift } from 'lucide-astro';

const whatsappOfferUrl = "https://wa.me/18036582620?text=Hola%21+Quiero+aprovechar+la+oferta+exclusiva+de+1+mes+gratis+al+suscribirme+a+IPTV+Espa%C3%B1a.";
---

<div
  id="exit-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <div class="relative w-full max-w-lg rounded-3xl bg-gradient-to-b from-[#1C0E12] via-[#0F111A] to-[#08090D] border-2 border-[#DC2626]/70 p-6 sm:p-8 shadow-[0_0_60px_rgba(220,38,38,0.4)] text-center transform scale-95 transition-transform duration-300 overflow-hidden">
    
    <!-- Top Ambient Accent -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-32 bg-[#DC2626]/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <!-- Close Button -->
    <button
      id="close-exit-popup"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#DC2626]"
      aria-label="Cerrar esta oferta"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Gift Icon Emblem -->
    <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-gradient-to-br from-[#DC2626] to-[#F59E0B] flex items-center justify-center shadow-[0_0_25px_rgba(220,38,38,0.5)]">
      <Gift class="w-8 h-8 text-white" />
    </div>

    <!-- Urgency Badge -->
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#F59E0B] text-[11px] font-black uppercase tracking-wider mb-3">
      <Clock class="w-3.5 h-3.5" />
      <span>Oferta Exclusiva de Última Oportunidad</span>
    </div>

    <!-- Main Title -->
    <h2 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
      ¡Espera! No Te Vayas con las Manos Vacías
    </h2>

    <!-- Mandatory Offer: Suscríbete ahora y llévate 1 mes gratis -->
    <p class="text-lg sm:text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#EF4444] via-[#F59E0B] to-[#EF4444] mb-3">
      ¡Suscríbete ahora y llévate 1 mes completamente gratis!
    </p>

    <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
      Accede a todo el fútbol de LaLiga en 4K Ultra HD con tecnología Anti-Freeze 9.8™, activación en 2 minutos vía WhatsApp y sin permanencia.
    </p>

    <!-- Highlights Checklist -->
    <div class="bg-black/50 rounded-2xl p-4 border border-white/5 mb-6 text-xs text-gray-300 space-y-2 text-left">
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span><strong>+1 mes extra gratuito</strong> añadido a tu plan de suscripción</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>Activación exprés en WhatsApp en menos de 2 minutos</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>Garantía de reembolso de 24 horas y pago con Bizum</span>
      </div>
    </div>

    <!-- CTA Button linking to WhatsApp -->
    <div class="flex flex-col gap-3">
      <a
        id="exit-popup-cta"
        href={whatsappOfferUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-[#DC2626] via-[#B91C1C] to-[#DC2626] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:shadow-[0_0_40px_rgba(220,38,38,0.7)] transition-all duration-300 hover:scale-[1.02]"
      >
        <MessageCircle class="w-5 h-5 text-emerald-300" />
        <span>Reclamar Mi Mes Gratis en WhatsApp</span>
      </a>

      <button
        id="dismiss-exit-popup"
        type="button"
        class="text-xs text-gray-400 hover:text-gray-200 transition-colors py-1.5 focus:outline-none"
      >
        No gracias, prefiero continuar sin el mes gratis
      </button>
    </div>

  </div>
</div>

<script>
  const STORAGE_KEY = 'spain_iptv_exit_popup_24h_v1';
  const POPUP_COOLDOWN_MS = 24 * 60 * 60 * 1000; // Strictly once per 24 hours per user

  let exitPopupShown = false;
  const popup = document.getElementById('exit-popup');
  const closeBtn = document.getElementById('close-exit-popup');
  const dismissBtn = document.getElementById('dismiss-exit-popup');
  const ctaBtn = document.getElementById('exit-popup-cta');

  function isEligibleToShow(): boolean {
    if (exitPopupShown) return false;
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown) {
      const timePassed = Date.now() - parseInt(lastShown, 10);
      if (timePassed < POPUP_COOLDOWN_MS) {
        return false;
      }
    }
    return true;
  }

  function showPopup() {
    if (!isEligibleToShow()) return;
    if (popup) {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      setTimeout(() => {
        popup.classList.remove('opacity-0');
        const modal = popup.querySelector('div');
        if (modal) modal.classList.remove('scale-95');
      }, 20);
      exitPopupShown = true;
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  function hidePopup() {
    if (popup) {
      popup.classList.add('opacity-0');
      const modal = popup.querySelector('div');
      if (modal) modal.classList.add('scale-95');
      setTimeout(() => {
        popup.classList.remove('flex');
        popup.classList.add('hidden');
      }, 300);
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  // Detect mouse leaving viewport at the top (Desktop exit intent)
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 10) {
      showPopup();
    }
  });

  // Mobile fallback: trigger after 45 seconds of browsing if eligible
  setTimeout(() => {
    showPopup();
  }, 45000);

  if (closeBtn) closeBtn.addEventListener('click', hidePopup);
  if (dismissBtn) dismissBtn.addEventListener('click', hidePopup);
  if (ctaBtn) ctaBtn.addEventListener('click', hidePopup);
</script>
