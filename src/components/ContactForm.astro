---
import { MessageCircle, Mail, Send, Clock, ShieldCheck, CheckCircle2 } from 'lucide-astro';

const whatsappUrl = "https://wa.me/18036582620";
const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramChannelUrl = "https://t.me/castvera_com";
---

<section id="contact" class="py-20 bg-[#08090D] relative overflow-hidden" aria-labelledby="contact-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#F59E0B] text-xs font-bold uppercase tracking-wider mb-4">
        Atención Directa y Soporte VIP
      </div>
      <h2 id="contact-title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Estamos a Tu Disposición <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#F59E0B] to-[#DC2626]">Las 24 Horas</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Escríbenos por WhatsApp o correo electrónico para resolver cualquier consulta técnica, solicitar tu prueba gratuita o contratar con Bizum.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Cards Column -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- WhatsApp Card -->
        <a
          href="https://wa.me/18036582620?text=Hola%21+Quiero+asistencia+de+soporte+IPTV+Espa%C3%B1a."
          target="_blank"
          rel="noopener noreferrer"
          class="block p-6 rounded-2xl bg-[#0F111A] border border-[#10B981]/40 hover:border-[#10B981] transition-all duration-300 shadow-lg group hover:-translate-y-1"
        >
          <div class="flex items-center gap-4 mb-2">
            <div class="w-12 h-12 rounded-xl bg-[#10B981]/20 border border-[#10B981]/40 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
              <MessageCircle class="w-6 h-6" />
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 block">Canal Preferente</span>
              <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors">WhatsApp Soporte 24/7</h3>
            </div>
          </div>
          <p class="text-xs text-gray-300 leading-relaxed">
            Respuesta promedio en menos de 2 minutos. Ideal para pruebas gratis, configuración guiada y pagos por Bizum.
          </p>
          <span class="text-xs font-mono font-bold text-emerald-400 block mt-3">+1 (803) 658-2620</span>
        </a>

        <!-- Email Cards -->
        <div class="p-6 rounded-2xl bg-[#0F111A] border border-white/[0.08] space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/[0.05] flex items-center justify-center text-[#F59E0B] flex-shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <h4 class="text-xs font-bold uppercase text-gray-400 tracking-wider">Consultas Generales y Ventas</h4>
              <a href="mailto:contact@iptvespana.cloud" class="text-sm font-semibold text-white hover:text-[#F59E0B] transition-colors">
                contact@iptvespana.cloud
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-3 border-t border-white/[0.05]">
            <div class="w-10 h-10 rounded-xl bg-white/[0.05] flex items-center justify-center text-[#DC2626] flex-shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <h4 class="text-xs font-bold uppercase text-gray-400 tracking-wider">Soporte Técnico Especializado</h4>
              <a href="mailto:support@castvera.com" class="text-sm font-semibold text-white hover:text-[#DC2626] transition-colors">
                support@castvera.com
              </a>
            </div>
          </div>
        </div>

        <!-- Community Channels -->
        <div class="grid grid-cols-2 gap-4">
          <a
            href={whatsappChannelUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.08] hover:border-[#10B981]/50 text-center transition-all group"
          >
            <MessageCircle class="w-5 h-5 text-emerald-400 mx-auto mb-1.5 group-hover:scale-110 transition-transform" />
            <span class="text-xs font-bold text-white block">Canal WhatsApp</span>
            <span class="text-[10px] text-gray-400">Avisos de partidos</span>
          </a>

          <a
            href={telegramChannelUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-[#0F111A] border border-white/[0.08] hover:border-[#0088cc]/50 text-center transition-all group"
          >
            <Send class="w-5 h-5 text-[#0088cc] mx-auto mb-1.5 group-hover:scale-110 transition-transform" />
            <span class="text-xs font-bold text-white block">Canal Telegram</span>
            <span class="text-[10px] text-gray-400">Comunidad VIP</span>
          </a>
        </div>

      </div>

      <!-- Contact Form Interactive Column -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-[#0F111A] border border-white/[0.08] shadow-2xl relative">
          
          <h3 class="text-2xl font-black text-white mb-2">Envíanos un Mensaje</h3>
          <p class="text-xs sm:text-sm text-gray-400 mb-8">
            Rellena el formulario y te responderemos inmediatamente a través de WhatsApp o correo electrónico.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold uppercase text-gray-400 mb-1.5">Tu Nombre</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Ej. Javier Gómez"
                  class="w-full px-4 py-3 rounded-xl bg-[#08090D] border border-white/[0.1] text-white text-sm focus:outline-none focus:border-[#DC2626] transition-colors"
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-xs font-bold uppercase text-gray-400 mb-1.5">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="contact-phone"
                  required
                  placeholder="Ej. +34 600 000 000"
                  class="w-full px-4 py-3 rounded-xl bg-[#08090D] border border-white/[0.1] text-white text-sm focus:outline-none focus:border-[#DC2626] transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-device" class="block text-xs font-bold uppercase text-gray-400 mb-1.5">Dispositivo que Utilizas</label>
              <select
                id="contact-device"
                class="w-full px-4 py-3 rounded-xl bg-[#08090D] border border-white/[0.1] text-white text-sm focus:outline-none focus:border-[#DC2626] transition-colors"
              >
                <option value="Amazon Fire TV Stick">Amazon Fire TV Stick</option>
                <option value="Smart TV Samsung / LG">Smart TV (Samsung / LG / Android)</option>
                <option value="Android Box / MAG / Formuler">Android Box / MAG / Formuler</option>
                <option value="Apple TV / iPhone / iPad">Apple TV / iPhone / iPad</option>
                <option value="Ordenador PC o Mac">Ordenador (PC / Mac)</option>
                <option value="Hostelería / Bar (IPTV Profesional)">Hostelería / Bar (IPTV Profesional)</option>
                <option value="Otro dispositivo">Otro dispositivo</option>
              </select>
            </div>

            <div>
              <label for="contact-msg" class="block text-xs font-bold uppercase text-gray-400 mb-1.5">Mensaje o Consulta</label>
              <textarea
                id="contact-msg"
                rows="4"
                placeholder="Hola, me gustaría solicitar una prueba de 24 horas y saber cómo pagar con Bizum..."
                class="w-full px-4 py-3 rounded-xl bg-[#08090D] border border-white/[0.1] text-white text-sm focus:outline-none focus:border-[#DC2626] transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_25px_rgba(220,38,38,0.4)] hover:shadow-[0_0_35px_rgba(220,38,38,0.6)] hover:scale-[1.01] transition-all flex items-center justify-center gap-2"
            >
              <MessageCircle class="w-4 h-4 text-emerald-300" />
              <span>Enviar Consulta a WhatsApp Directo</span>
            </button>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement).value;
      const phone = (document.getElementById('contact-phone') as HTMLInputElement).value;
      const device = (document.getElementById('contact-device') as HTMLSelectElement).value;
      const msg = (document.getElementById('contact-msg') as HTMLTextAreaElement).value;

      const fullMessage = `Hola, mi nombre es ${name} (Tel: ${phone}). Uso el dispositivo: ${device}. Consulta: ${msg || 'Deseo solicitar información y prueba de 24h de IPTV España.'}`;
      const url = `https://wa.me/18036582620?text=${encodeURIComponent(fullMessage)}`;
      window.open(url, '_blank');
    });
  }
</script>
